{
  "layer": "top",
  "position": "top",
  "reload_style_on_change": true, 

  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["temperature#cpu", "temperature#gpu", "memory", "network", "pulseaudio", "custom/audiotoggle"],

  "memory": {
    "format": "   {}%",
    "tooltip-format": "{used:0.1f}GB / {total:0.1f}GB"
  },

  "temperature#cpu": {
    "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
    "format": "  {temperatureC}°C",
    "tooltip": false
  },

  "temperature#gpu": {
    "hwmon-path": "/sys/class/hwmon/hwmon0/temp1_input", 
    "format": "󰢮  {temperatureC}°C",
    "tooltip": false
  },

  // Updated Hyprland workspaces module
  "hyprland/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
    "format-icons": {
      "active": "",
      "default": "",
      "empty": ""
    },
    "persistent-workspaces": {
      "*": 5
    }
  },

  // Network using the latest tooltip-format-wifi formatting
  "network": {
    "format-wifi": "{icon}  {essid}", 
    "format-ethernet": "󰈀  {ifname}",
    "format-disconnected": "󰖪  Disconnected",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"], 
    "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}",
    "tooltip-format-ethernet": "{ifname}",
    "on-click": "rofi -modi 'nm:/home/haziel/rofi-network-manager/network-manager.sh' -show nm"
  },

  // Clock utilizing the modern calendar object for tooltips
  "clock": {
    "timezone": "America/Argentina/Buenos_Aires",
    "format": "  {:%H:%M}",
    "format-alt": "  {:%A, %B %d, %Y}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "on-scroll": 1,
      "format": {
        "months": "<span color='#88c0d0'><b>{}</b></span>",
        "days": "<span color='#d8dee9'><b>{}</b></span>",
        "weekdays": "<span color='#a3be8c'><b>{}</b></span>",
        "today": "<span color='#ebcb8b'><b><u>{}</u></b></span>"
      }
    }
  },

  "pulseaudio": {
    "format": "  {volume}%",
    "format-muted": "󰝟  Muted",
    "on-click": "pavucontrol"
  },

  "custom/audiotoggle": {
    "exec": "~/.config/waybar/toggle-audio.sh status",
    "on-click": "~/.config/waybar/toggle-audio.sh toggle",
    "interval": 1,
    "tooltip": false
  }
}